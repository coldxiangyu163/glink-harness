{
  "name": "@pi-glink/dsh-web-fetch-jina",
  "version": "0.1.0",
  "private": true,
  "description": "Jina Reader (r.jina.ai) fetch provider for the DeepSeek Harness web seam (ctx.web), shipped out-of-tree by pi-glink",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-credentials": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-launch-environment": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-timeout": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-web": "^0.1.5-rc.3"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2"
  }
}
