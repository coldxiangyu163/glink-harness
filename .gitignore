# 凭据与本地运行态
.env
.env.*
!.env.example
data/
*.log

# Python
__pycache__/
*.py[cod]
.venv/
/.venv
.uv/
*.egg-info/
.pytest_cache/

# Node / pi 运行痕迹（前端无打包步骤，这里只挡工具缓存）
node_modules/
.pi/

# 本地 agent 工具的运行痕迹：不是产品配置，也没有仓库契约。
#   .pi-subagents/  pi-subagents 的 artifactDir 默认 project，子 agent 产物写在 cwd
#   .feynman/       检索内容缓存（fetch-content）
#   .herdr/         委派 brief 与评审报告
.pi-subagents/
.feynman/
.herdr/

# 手动 run 的落地目录：成稿、草稿、检索中间件与来源附件。
# 产品自己的数据根是 LOCAL_WEB_DATA_ROOT（默认 ~/.glink-harness，见 host/glink_harness/config.py），
# 仓库里这两个目录只在开发期使用，且含客户资料与二进制附件，不进版本库。
# 确实需要留档时用 `git add -f <路径>` 显式加回。
outputs/
notes/

# pi 会把运行时状态写进它的配置目录。仓库里的 harnesses/pi/ 只是模板：
# 真正的配置目录由宿主渲染到数据根下（见 host/glink_harness/kernel/agent_env.py），
# 这几条防线保证即使误把包目录当成配置目录也不会把状态提交进去。
harnesses/pi/auth.json
harnesses/pi/models-store.json
harnesses/pi/sessions/
harnesses/pi/web-search.json

# 编辑器与系统
.DS_Store
.idea/
.vscode/
.coverage
