# 凭据与本地运行态
.env
.env.*
!.env.example
data/
*.log

# Python
__pycache__/
*.py[cod]
.venv/
.uv/
*.egg-info/
.pytest_cache/

# Node / pi 运行痕迹（前端无打包步骤，这里只挡工具缓存）
node_modules/
.pi/

# pi 会把运行时状态写进它的配置目录。仓库里的 agent/ 只是模板：
# 真正的配置目录由宿主渲染到数据根下（见 host/pi_glink/kernel/agent_env.py），
# 这几条防线保证即使误把 agent/ 当成配置目录也不会把状态提交进去。
agent/auth.json
agent/models-store.json
agent/sessions/
agent/web-search.json

# 编辑器与系统
.DS_Store
.idea/
.vscode/
