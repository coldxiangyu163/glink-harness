# pi-glink 环境变量
#
# 变量命名与 FrontierAgent 保持一致（模型用 OPENAI_*，云沙箱用 E2B_*，
# 服务与执行面用 LOCAL_WEB_*），只为本项目独有的概念新增 PI_GLINK_* 前缀。
# 复制为 .env 后填写；.env 已被 .gitignore 忽略，密钥不得进入仓库。

# ────────────────────────────────────────────────────────────────
# 研究模型（与 FrontierAgent 同源）
# ────────────────────────────────────────────────────────────────
# OPENAI_BASE_URL 必须是普通 HTTP(S) 端点，且指向 OpenAI 兼容接口。
# pi 侧通过同一组变量解析 provider，不维护第二套模型配置。
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# ────────────────────────────────────────────────────────────────
# 本地服务
# ────────────────────────────────────────────────────────────────
# 默认只监听回环地址；绑定非回环地址必须同时设置 LOCAL_WEB_ALLOW_REMOTE=1。
LOCAL_WEB_PORT=7860
# LOCAL_WEB_HOST=127.0.0.1
# LOCAL_WEB_ALLOW_REMOTE=
# LOCAL_WEB_LOG_LEVEL=INFO
# LOCAL_WEB_DATA_ROOT=          # 默认 ~/.pi-glink（运行态、会话、工作区）

# ────────────────────────────────────────────────────────────────
# 执行面：inproc（本机进程）| docker | e2b
# ────────────────────────────────────────────────────────────────
# 三种执行面语义与 FrontierAgent 一致：pi 进程整体跑在目标环境内，
# 宿主只消费它的 headless 事件流。
# LOCAL_WEB_EXECUTOR=inproc

# pi 内核（本机执行面）
# PI_GLINK_PI_BIN=pi            # 可执行文件或绝对路径
# PI_CODING_AGENT_DIR=          # pi 配置目录；默认 <repo>/agent
# PI_CODING_AGENT_SESSION_DIR=  # pi 会话目录；默认 <LOCAL_WEB_DATA_ROOT>/sessions
# PI_GLINK_WORKSPACE_ROOT=      # 每次 run 的工作区根；默认 <LOCAL_WEB_DATA_ROOT>/workspaces

# ────────────────────────────────────────────────────────────────
# Docker 执行面（task-6）
# ────────────────────────────────────────────────────────────────
# LOCAL_WEB_WORKER_IMAGE=pi-glink-worker:latest

# ────────────────────────────────────────────────────────────────
# E2B 云沙箱（与 FrontierAgent 同源）
# ────────────────────────────────────────────────────────────────
E2B_API_KEY=
LOCAL_WEB_E2B_TEMPLATE=pi-glink-worker

# ────────────────────────────────────────────────────────────────
# 搜索（pi-web-access 扩展）
# ────────────────────────────────────────────────────────────────
# 留空时：宿主复制操作员本机的 ~/.pi/agent/web-search.json；两者都没有也能用
# （pi-web-access 回退到无密钥的 Exa MCP 检索）。
# PI_GLINK_WEB_SEARCH_KEY=          # Exa API key，渲染为 exaApiKey
# PI_GLINK_WEB_SEARCH_CONFIG=       # 或直接指定一份 web-search.json 的路径
