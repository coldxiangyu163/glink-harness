# pi-glink 环境变量
#
# 变量命名与 FrontierAgent 保持一致（模型用 OPENAI_*，云沙箱用 E2B_*，
# 服务与执行面用 LOCAL_WEB_*），只为本项目独有的概念新增 PI_GLINK_* 前缀。
# 复制为 .env 后填写；.env 已被 .gitignore 忽略，密钥不得进入仓库。

# ────────────────────────────────────────────────────────────────
# 研究模型（与 FrontierAgent 同源）
# ────────────────────────────────────────────────────────────────
# OPENAI_BASE_URL 必须是普通 HTTP(S) 端点，且指向 OpenAI 兼容接口。
# pi 侧通过同一组变量解析 provider，不维护第二套模型配置。
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# ────────────────────────────────────────────────────────────────
# 本地服务
# ────────────────────────────────────────────────────────────────
# 默认只监听回环地址，且只允许回环地址：远端访问必须由本机认证网关反代
# （见下方多租户）。历史开关 LOCAL_WEB_ALLOW_REMOTE 不再接受，也不会开启
# 无认证公网模式。
# 固定端口范围 1–65535；0 表示请内核分配临时端口（仅测试/本地调试，仍只绑 loopback）。
LOCAL_WEB_PORT=7860
# LOCAL_WEB_HOST=127.0.0.1
# LOCAL_WEB_LOG_LEVEL=INFO
# LOCAL_WEB_DATA_ROOT=          # 默认 ~/.pi-glink（运行态、会话、工作区）
# 同时打开的 SSE 连接上限（全局；多租户时每租户另有上限）。额度在写出任何流响应头之前检查，
# 超额返回 429 {"error":"stream_limit"}（不含 run id）；local 只用全局上限。
# PI_GLINK_MAX_GLOBAL_STREAMS=64
# PI_GLINK_MAX_TENANT_STREAMS=16

# ────────────────────────────────────────────────────────────────
# 执行面：inproc（本机进程）| docker | e2b
# ────────────────────────────────────────────────────────────────
# 三种执行面语义与 FrontierAgent 一致：pi 进程整体跑在目标环境内，
# 宿主只消费它的 headless 事件流。
# LOCAL_WEB_EXECUTOR=inproc

# pi 内核（本机执行面）
# PI_GLINK_PI_BIN=pi            # 可执行文件或绝对路径
# PI_CODING_AGENT_DIR=          # pi 配置目录；默认 <repo>/agent
# PI_CODING_AGENT_SESSION_DIR=  # pi 会话目录；默认 <LOCAL_WEB_DATA_ROOT>/sessions
# PI_GLINK_WORKSPACE_ROOT=      # 每次 run 的工作区根；默认 <LOCAL_WEB_DATA_ROOT>/workspaces

# ────────────────────────────────────────────────────────────────
# Docker 执行面（task-6）
# ────────────────────────────────────────────────────────────────
# LOCAL_WEB_WORKER_IMAGE=pi-glink-worker:latest
# 每个容器实例的资源上限与特权降低（不改镜像，只影响 docker run 参数）：
# LOCAL_WEB_DOCKER_CPUS=2
# LOCAL_WEB_DOCKER_MEMORY=2g
# LOCAL_WEB_DOCKER_PIDS_LIMIT=512

# ────────────────────────────────────────────────────────────────
# E2B 云沙箱（与 FrontierAgent 同源）
# ────────────────────────────────────────────────────────────────
E2B_API_KEY=
LOCAL_WEB_E2B_TEMPLATE=pi-glink-worker
# 沙箱生命周期上限（秒）；0 表示 task timeout + 300。E2B SDK 不暴露 CPU/内存控制，
# 本宿主只承诺自己实际传给云端的限制。
# LOCAL_WEB_E2B_TIMEOUT_SECONDS=0

# ────────────────────────────────────────────────────────────────
# 资源台账（Docker/E2B 执行面）
# ────────────────────────────────────────────────────────────────
# 未确认释放的 run 在后台按持久化的执行身份被周期性确认：Docker 只 inspect 记录里的容器名
# （必要时幂等 rm -f 后复查，不猜名字、不批量），E2B 只按记录的 sandbox_id 用冻结凭据查询/
# 终止；确认只认执行面契约（不存在 / kill 返回 False / SDK NotFound 类型），其余一律保持持有。
# 确认后写 resource_adjudication{source:"auto-verified",method,at}，与人工裁决
# （source:"operator"）区分；0 关闭在线对账（离线 --unreleased/--mark-released 仍可用）。
# inproc 不取得外部资源，不启用该线程。
# PI_GLINK_RESOURCE_RECONCILE_SECONDS=60

# ────────────────────────────────────────────────────────────────
# 多租户（PI_GLINK_TENANCY=multitenant；默认 local）
# ────────────────────────────────────────────────────────────────
# 只支持单宿主 + 本机认证网关反代：网关注入每个请求的身份断言，宿主验签。
# 开启后：只允许绑定 loopback；执行面必须是 docker/e2b；身份与租户凭据文件必须
# 放在仓库外、权限 0600；任一缺失或不合法都拒绝启动（不会回落无认证本地模式）。
# 断言头：X-Pi-Glink-Identity，值形如 <v1>.<base64url(payload)>.<base64url(hmac)>，
# payload 至少含 tenantId/userId/role/audience/iat/exp；role 必须是 member/admin
# 字符串，exp 过期即拒绝（无宽限）。网关必须清除客户端同名请求头。示例（全部为
# 虚构占位符，不是真实密钥）：
#
#   PI_GLINK_TENANCY=multitenant
#   LOCAL_WEB_HOST=127.0.0.1
#   LOCAL_WEB_EXECUTOR=docker
#   PI_GLINK_GATEWAY_SECRET_FILE=/etc/pi-glink/gateway.key      # 0600，≥32 字节
#   PI_GLINK_TENANT_CONFIG_FILE=/etc/pi-glink/tenants.json      # 0600
#   PI_GLINK_TENANCY_AUDIENCE=pi-glink
#   PI_GLINK_MAX_GLOBAL_RUNS=4
#   PI_GLINK_MAX_TENANT_RUNS=2
#   PI_GLINK_ASSERTION_MAX_SECONDS=300    # 断言寿命上限
#   PI_GLINK_ASSERTION_SKEW_SECONDS=30    # 容忍的时钟偏移
#
# tenants.json 形如（键名固定，值全部为虚构占位符）：
#   {"tenants": {"tenant-alpha": {"modelApiKey": "sk-alpha-placeholder",
#                              "webSearchKey": "search-placeholder"},
#                "tenant-beta":  {"modelApiKey": "sk-beta-placeholder"}}}
# 缺 modelApiKey 的租户一律拒绝准入，绝不回退宿主全局 OPENAI_API_KEY。
#
# 模型凭据策略（仅 PI_GLINK_TENANCY=multitenant 有意义）：tenant（默认）| shared
#   tenant：现行为——每个租户必须在 tenants.json 里配置自己的 modelApiKey；
#     缺 key 拒绝准入，搜索 key 可选项沿用每租户 webSearchKey。
#   shared：SaaS 部署由宿主统一提供模型凭据。宿主必须在启动时冻结
#     OPENAI_API_KEY、OPENAI_BASE_URL、OPENAI_MODEL；可选搜索 key 只来自宿主级
#     PI_GLINK_WEB_SEARCH_KEY，绝不会读取操作员 ~/.pi/web-search.json 顶替。
#     共享模式不读取任何租户配置：不得配置 PI_GLINK_TENANT_CONFIG_FILE
#     （不设置或留空即为无该入口），设置即拒绝启动，也不会构造/读取租户凭据存储。
#     这是显式放宽，不是全局兜底：shared 配置不完整时宿主拒绝启动，绝不回退 tenant
#     或 local；executor 仍只允许 docker/e2b，inproc 仍被拒绝。
# PI_GLINK_MODEL_CREDENTIALS=tenant

# ────────────────────────────────────────────────────────────────
# 身份入口：gateway（默认，网关签名断言）| accounts（站内邀请注册 + 会话）
# ────────────────────────────────────────────────────────────────
# 仅 PI_GLINK_TENANCY=multitenant 时有意义；accounts 与 gateway 互斥，绝不互相回退。
# PI_GLINK_AUTH_MODE=gateway

# accounts 模式：
#   · 不再需要 PI_GLINK_GATEWAY_SECRET_FILE / PI_GLINK_TENANCY_AUDIENCE；
#   · 账号库在仓库外、且必须位于 LOCAL_WEB_DATA_ROOT 之内
#     （默认 <LOCAL_WEB_DATA_ROOT>/accounts/accounts.db，SQLite WAL），与 run/events
#     文件存储分离，不自动迁移任何历史；自定义路径也必须落在同一 data_root，禁止
#     跨 data_root 共用一份账号库来绕过 host.lock。
#   · 权限：宿主在首次创建时建立 0700 的专用目录和 0600 的库文件，WAL/SHM 侧车
#     同样要求属主独占；已有目录/文件权限过宽或是指向别处的符号链接时拒绝启动，
#     绝不自动 chmod。旧库处理：停止宿主，把库移到 0700 目录并 chmod 600 后重启；
#     无法确认来源时先备份再处理。
#   · 宿主仍只监听 loopback，生产必须由 TLS 终止代理提供 HTTPS；会话 cookie 默认
#     带 Secure。只允许在回环 HTTP 调试时显式设为 0，绝不能把 0 带上生产。
#   · 首位管理员（宿主停止时离线执行）：tenant 策略下该租户必须已有模型凭据；
#     PI_GLINK_MODEL_CREDENTIALS=shared 时只校验宿主冻结的共享模型配置，不配置
#     租户凭据文件（首个邀请会创建组织记录）：
#       python -m pi_glink.app --create-invite --tenant tenant-alpha \
#         --tenant-name 组织甲 --email admin@example.com --role admin
# PI_GLINK_ACCOUNTS_DB=
# PI_GLINK_PUBLIC_ORIGIN=            # 反代对外的 HTTPS 源，如 https://glink.example.com
# PI_GLINK_COOKIE_SECURE=1
# 提示：所有整数配置都有范围校验（端口 0–65535、并发上限/超时/限速/资源上限必须为正、
# 对账间隔与时钟偏移可为 0）；越界或非正会在启动时报出变量名并拒绝启动。
# PI_GLINK_SESSION_ABSOLUTE_SECONDS=43200   # 会话绝对有效期（12 小时）
# PI_GLINK_SESSION_IDLE_SECONDS=7200        # 空闲失效（2 小时）
# PI_GLINK_INVITE_TTL_SECONDS=172800        # 邀请默认有效期（48 小时）
# PI_GLINK_LOGIN_MAX_ATTEMPTS=5             # 每个账号每窗口的登录尝试
# PI_GLINK_LOGIN_WINDOW_SECONDS=300
# 每个 socket peer 每窗口的登录尝试：按客户端地址计数，**绝不读 X-Forwarded-For**。
# 经 TLS 反代时所有用户共享同一个 peer（通常是 127.0.0.1），这个值就是整个部署的
# 登录预算上限，因此默认给得比单账号宽；它挡住的是「不断换邮箱触发 scrypt」的 CPU
# 消耗。请按团队规模调整，并知道调大等于放宽这一层保护。
# PI_GLINK_LOGIN_PEER_MAX_ATTEMPTS=120
# PI_GLINK_LOGIN_PEER_WINDOW_SECONDS=60
# PI_GLINK_REGISTER_MAX_ATTEMPTS=10         # 每个来源地址每窗口的注册尝试
# PI_GLINK_REGISTER_WINDOW_SECONDS=900
# PI_GLINK_INVITE_CHECK_MAX_ATTEMPTS=60     # 每个来源地址每窗口的邀请校验
# PI_GLINK_INVITE_CHECK_WINDOW_SECONDS=300

# ────────────────────────────────────────────────────────────────
# 搜索（pi-web-access 扩展）
# ────────────────────────────────────────────────────────────────
# 留空时：宿主复制操作员本机的 ~/.pi/agent/web-search.json；两者都没有也能用
# （pi-web-access 回退到无密钥的 Exa MCP 检索）。
# 多租户下：tenant 策略只渲染该租户条目的 webSearchKey；shared 策略只渲染本变量
# （宿主级共享），两种策略都不会读取操作员本机文件来顶替。
# PI_GLINK_WEB_SEARCH_KEY=          # Exa API key，渲染为 exaApiKey
# PI_GLINK_WEB_SEARCH_CONFIG=       # 或直接指定一份 web-search.json 的路径（仅 local 生效）
