# pi-glink worker 镜像：容器内自包含 pi 运行时。
#
# 设计边界（对应 task-6 的验收契约）：
#   * 镜像自带 Node 与 pi，容器内的执行不依赖宿主安装的运行时；
#   * 宿主只提供数据通道：工作区 /workspace、运行期配置 /config、会话 /sessions，
#     以及通过环境变量注入的模型凭据（不以文件形式进入镜像）；
#   * pi 版本在此固定，便于「不改内核、只换版本号」的升级演练（task-9）。
#
# 构建：
#   docker build -t pi-glink-worker:latest -f docker/Dockerfile.worker .
#
# 网络受限环境（例如中国大陆）可覆盖基础源，仓库默认仍用官方源：
#   docker build -t pi-glink-worker:latest -f docker/Dockerfile.worker \
#     --build-arg DEBIAN_MIRROR=mirrors.aliyun.com \
#     --build-arg NPM_REGISTRY=https://registry.npmmirror.com .
FROM node:24-bookworm-slim

ARG PI_VERSION=0.86.1
ARG DEBIAN_MIRROR=deb.debian.org
ARG NPM_REGISTRY=https://registry.npmjs.org

RUN if [ "${DEBIAN_MIRROR}" != "deb.debian.org" ]; then \
      sed -i "s|deb.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       bash ca-certificates curl git ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && npm config set registry "${NPM_REGISTRY}" \
    && npm install -g --ignore-scripts "@earendil-works/pi-coding-agent@${PI_VERSION}" \
    && npm cache clean --force

# 运行期由宿主覆盖为挂载点；这里给出容器内默认值，便于单独调试。
ENV PI_CODING_AGENT_DIR=/config \
    PI_CODING_AGENT_SESSION_DIR=/sessions \
    PI_SKIP_VERSION_CHECK=1 \
    PI_TELEMETRY=0

WORKDIR /workspace
ENTRYPOINT []
CMD ["pi", "--version"]
